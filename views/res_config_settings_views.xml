<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_club_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.club.chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pickleball-team.res_config_settings_view_form_pickleball"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='pickleball_team']" position="inside">
                <block title="Website Chat" name="pickleball_website_chat_setting_container">
                    <setting id="pickleball_website_chat_admins_setting" string="Admins receiving the chat"
                             help="Messages members send from the chat bubble of the club website arrive in Discuss for these users. Empty: every Settings administrator.">
                        <field name="pickleball_chat_admin_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="Every Settings administrator"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
