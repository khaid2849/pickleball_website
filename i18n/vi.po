#. module: pickleball_website
#: model:mail.template,body_html:pickleball_website.mail_template_website_password_confirm
msgid ""
"<div style=\"margin:0; padding:24px; background:#fbf6ec; font-family:Montserrat,Arial,sans-serif; color:#1b2070;\">\n"
"    <div style=\"max-width:560px; margin:0 auto; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 6px 0 rgba(27,32,112,0.12);\">\n"
"        <div style=\"padding:22px 28px; background:#3d55e8; color:#ffffff;\">\n"
"            <span style=\"display:inline-block; padding:6px 16px; background:#ec5f4b; font-size:20px; font-weight:900; text-transform:uppercase;\">\n"
"                <t t-out=\"object.env['website'].get_current_website().name or object.env.company.name\"/>\n"
"            </span>\n"
"        </div>\n"
"        <div style=\"padding:28px;\">\n"
"            <p style=\"font-size:18px; font-weight:800; margin:0 0 12px;\">Xin chào <t t-out=\"object.name\"/>!</p>\n"
"            <p style=\"margin:0 0 20px; line-height:1.6;\">\n"
"                Bạn vừa yêu cầu đổi mật khẩu tài khoản website của đội\n"
"                (tên đăng nhập <b t-out=\"object.user_id.login\"/>). Mật khẩu mới chỉ có hiệu lực\n"
"                sau khi bạn bấm nút dưới đây và xác nhận.\n"
"            </p>\n"
"            <p style=\"margin:0 0 24px;\">\n"
"                <a t-att-href=\"ctx.get('confirm_url')\" style=\"display:inline-block; padding:12px 24px; background:#ec5f4b; color:#ffffff; border-radius:10px; font-weight:800; text-decoration:none; text-transform:uppercase;\">\n"
"                    Xác nhận đổi mật khẩu\n"
"                </a>\n"
"            </p>\n"
"            <p style=\"margin:0 0 6px; color:#5d6290; font-size:13px;\">\n"
"                Liên kết có hiệu lực trong <t t-out=\"ctx.get('valid_minutes')\"/> phút. Nếu không phải bạn yêu cầu,\n"
"                hãy bỏ qua email này: mật khẩu của bạn sẽ không thay đổi — và nên báo cho admin của đội.\n"
"            </p>\n"
"            <p style=\"margin:0 0 6px; color:#5d6290; font-size:13px;\">\n"
"                You asked for a new password on the club website. Click the button above to confirm it\n"
"                (valid for <t t-out=\"ctx.get('valid_minutes')\"/> minutes). Didn't ask for it? Ignore this email:\n"
"                your password stays the same.\n"
"            </p>\n"
"            <p style=\"margin:12px 0 0; color:#5d6290; font-size:12px; word-break:break-all;\">\n"
"                <t t-out=\"ctx.get('confirm_url')\"/>\n"
"            </p>\n"
"        </div>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""

