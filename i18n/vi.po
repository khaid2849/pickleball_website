#. module: pickleball_website
#: model:mail.template,body_html:pickleball_website.mail_template_website_signup_approved
msgid ""
"<div style=\"margin:0; padding:24px; background:#fbf6ec; font-family:Montserrat,Arial,sans-serif; color:#1b2070;\">\n"
"    <div style=\"max-width:560px; margin:0 auto; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 6px 0 rgba(27,32,112,0.12);\">\n"
"        <div style=\"padding:22px 28px; background:#3d55e8; color:#ffffff;\">\n"
"            <span style=\"display:inline-block; padding:6px 16px; background:#ec5f4b; font-size:20px; font-weight:900; text-transform:uppercase;\">\n"
"                <t t-out=\"object.env['website'].get_current_website().name or object.env.company.name\"/>\n"
"            </span>\n"
"        </div>\n"
"        <div style=\"padding:28px;\">\n"
"            <p style=\"font-size:18px; font-weight:800; margin:0 0 12px;\">Chào mừng <t t-out=\"object.name\"/> vào đội! 🎉</p>\n"
"            <p style=\"margin:0 0 16px; line-height:1.6;\">\n"
"                Tài khoản website của bạn đã được duyệt. Giờ bạn có thể đăng nhập để xem thẻ cầu thủ,\n"
"                lịch thi đấu, bảng xếp hạng và tài chính của mình.\n"
"            </p>\n"
"            <p style=\"margin:0 0 20px; padding:12px 16px; background:#fbf6ec; border-radius:10px; line-height:1.6;\">\n"
"                Tên đăng nhập / Username: <b t-out=\"object.user_id.login\"/><br/>\n"
"                Email: <b t-out=\"object.user_id.email\"/>\n"
"            </p>\n"
"            <p style=\"margin:0 0 24px;\">\n"
"                <a t-att-href=\"ctx.get('login_url')\" style=\"display:inline-block; padding:12px 24px; background:#ec5f4b; color:#ffffff; border-radius:10px; font-weight:800; text-decoration:none; text-transform:uppercase;\">\n"
"                    Đăng nhập\n"
"                </a>\n"
"            </p>\n"
"            <p style=\"margin:0; color:#5d6290; font-size:13px;\">\n"
"                Your club website account is approved: log in with your username or email\n"
"                and the password you chose when signing up.\n"
"            </p>\n"
"        </div>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""

#. module: pickleball_website
#: model:mail.template,body_html:pickleball_website.mail_template_website_signup_confirm
msgid ""
"<div style=\"margin:0; padding:24px; background:#fbf6ec; font-family:Montserrat,Arial,sans-serif; color:#1b2070;\">\n"
"    <div style=\"max-width:560px; margin:0 auto; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 6px 0 rgba(27,32,112,0.12);\">\n"
"        <div style=\"padding:22px 28px; background:#3d55e8; color:#ffffff;\">\n"
"            <span style=\"display:inline-block; padding:6px 16px; background:#ec5f4b; font-size:20px; font-weight:900; text-transform:uppercase;\">\n"
"                <t t-out=\"object.env['website'].get_current_website().name or object.env.company.name\"/>\n"
"            </span>\n"
"        </div>\n"
"        <div style=\"padding:28px;\">\n"
"            <p style=\"font-size:18px; font-weight:800; margin:0 0 12px;\">Xin chào <t t-out=\"object.name\"/>!</p>\n"
"            <p style=\"margin:0 0 20px; line-height:1.6;\">\n"
"                Cảm ơn bạn đã đăng ký tài khoản thành viên. Bấm nút dưới đây để xác nhận email\n"
"                và bắt đầu dùng khu thành viên của đội.\n"
"            </p>\n"
"            <p style=\"margin:0 0 24px;\">\n"
"                <a t-att-href=\"ctx.get('confirm_url')\" style=\"display:inline-block; padding:12px 24px; background:#ec5f4b; color:#ffffff; border-radius:10px; font-weight:800; text-decoration:none; text-transform:uppercase;\">\n"
"                    Xác nhận email\n"
"                </a>\n"
"            </p>\n"
"            <p style=\"margin:0 0 6px; color:#5d6290; font-size:13px;\">\n"
"                Thanks for signing up! Click the button above to confirm your email.\n"
"                The link is valid for 48 hours. If you didn't sign up, just ignore this email.\n"
"            </p>\n"
"            <p style=\"margin:12px 0 0; color:#5d6290; font-size:12px; word-break:break-all;\">\n"
"                <t t-out=\"ctx.get('confirm_url')\"/>\n"
"            </p>\n"
"        </div>\n"
"    </div>\n"
"</div>\n"
"            "
msgstr ""

